      "_localized": {
        "/Name": {
          "key": "StarTower.102.1",
          "zh_TW": "流水與暗影",
          "zh_CN": "流水与暗影",
          "sources": {
            "zh_TW": "language/zh_TW/StarTower.json",
            "zh_CN": "language/zh_CN/StarTower.json"
          }
        },
        "/Desc": {
          "key": "StarTower.102.2",
          "zh_TW": "遍布陰影與水氣的星塔。墮入此處的情感，令人感到壓抑而難以呼吸…\u000b掌控地或光屬性的旅人在此具有優勢。",
          "zh_CN": "遍布着阴影与水汽的星塔。堕入此处的情感，让人压抑而难以呼吸……\u000b掌控地或光属性的旅人，在此会获得优势。",
          "sources": {
            "zh_TW": "language/zh_TW/StarTower.json",
            "zh_CN": "language/zh_CN/StarTower.json"
          }
        }
      }
    },
