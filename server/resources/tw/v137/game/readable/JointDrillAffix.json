      "Icon": "Icon/MonsterSkill/JointDrill/Icon_JointDrill_JuYuanMeiYing_002",
      "_localized": {
        "/Name": {
          "key": "JointDrillAffix.10002.1",
          "zh_TW": "交響曲·複誦",
