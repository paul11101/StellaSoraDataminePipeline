      "_localized": {
        "/Name": {
          "key": "JointDrillAffix.10001.1",
          "zh_TW": "交響曲·嘆息",
          "zh_CN": "交响曲·叹息",
          "sources": {
            "zh_TW": "language/zh_TW/JointDrillAffix.json",
            "zh_CN": "language/zh_CN/JointDrillAffix.json"
          }
        },
        "/Desc": {
          "key": "JointDrillAffix.10001.2",
          "zh_TW": "首領敵人擁有「迴響魔典」，「迴響魔典」會在受到一定次數的傷害後消散。「迴響魔典」會在首領敵人施放特定技能時施放類似的技能",
          "zh_CN": "首领敌人拥有「回响魔典」，「回响魔典」在受到一定次数的伤害后消散。「回响魔典」会在首领敌人施放特定技能时施放相似的技能",
          "sources": {
            "zh_TW": "language/zh_TW/JointDrillAffix.json",
            "zh_CN": "language/zh_CN/JointDrillAffix.json"
          }
        }
      }
    },
    "10002": {
      "Id": 10002,
      "Name": "JointDrillAffix.10002.1",
