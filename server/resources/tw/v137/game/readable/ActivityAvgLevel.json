        "/Name": {
          "key": "ActivityAvgLevel.10001.2",
          "zh_TW": "閃爍的微光",
          "zh_CN": "闪烁的微光",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10001.3",
          "zh_TW": "夏日的海濱小鎮，流傳著一則恐怖傳說：\n遠海之上閃爍著「幽靈船」的綠光。\n你目睹了那詭異的光芒被大海吞沒…",
          "zh_CN": "夏日的海滨小镇，流传着一则恐怖传说：\n远海之上，闪烁着“幽灵船”的绿光。\n你目睹了那诡异的光芒，被大海吞没……",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
    },
