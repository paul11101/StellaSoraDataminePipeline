        },
        "/Name": {
          "key": "ActivityAvgLevel.10002.2",
          "zh_TW": "來自幽靈船",
          "zh_CN": "来自幽灵船",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10002.3",
          "zh_TW": "兩位陌生的兔子少女救了你。\n她們要去尋找「幽靈船」光芒的源頭。",
          "zh_CN": "两位陌生的兔子少女搭救了你。\n她们要去寻找“幽灵船”光芒的源头。",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
    },
