        "/Name": {
          "key": "ActivityAvgLevel.10009.2",
          "zh_TW": "光的原點",
          "zh_CN": "光的原点",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10009.3",
          "zh_TW": "暴雨之中，六角鯨的骸骨散發出強烈的光芒。\n這裡是牠們的棲息地、墳墓。\n也是無數旅人誤以為埋藏寶藏的天國。",
          "zh_CN": "暴雨之中，六角鲸的骸骨散发着强烈的光。\n这里是它们的栖息地、坟墓。\n也是无数旅人误以为埋藏宝藏的天国。",
          "sources": {
