        "/Name": {
          "key": "ActivityAvgLevel.10005.2",
          "zh_TW": "眼見非實",
          "zh_CN": "眼见非实",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10005.3",
          "zh_TW": "種種線索表明，奶奶撒謊了。\n「幽靈船」只是掩人耳目的幌子。\n「面對真相，我們需要一些勇氣。」",
          "zh_CN": "种种线索表明，奶奶撒谎了。\n“幽灵船”只是掩人耳目的幌子。\n“面对真相，我们需要一些勇气。”",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
