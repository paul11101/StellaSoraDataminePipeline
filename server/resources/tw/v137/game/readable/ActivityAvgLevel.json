          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10006.3",
          "zh_TW": "對於奶奶的隱瞞，希婭早已有所察覺。\n她決定先走一步，去前方探查情況。\n然而，黑暗中有一個身影始終注視著她。",
          "zh_CN": "对于奶奶的隐瞒，希娅早已有所察觉。\n她决定先走一步，去前方探查情况。\n然而，黑暗中有一个身影始终注视着她。",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
