        },
        "/Name": {
          "key": "ActivityAvgLevel.10003.2",
          "zh_TW": "謎團與氣味",
          "zh_CN": "谜团与气味",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10003.3",
          "zh_TW": "你得知了希婭和花鈴此行的目的：\n她們要為奶奶正名。\n不知為何，希婭對你異常親近…",
          "zh_CN": "你得知了希娅和花铃此行的目的：\n她们要为奶奶正名。\n不知为何，希娅对你异常亲近……",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
    },
