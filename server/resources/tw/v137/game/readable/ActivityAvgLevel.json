        },
        "/Name": {
          "key": "ActivityAvgLevel.10004.2",
          "zh_TW": "聲音的指示",
          "zh_CN": "声音的指示",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10004.3",
          "zh_TW": "行程過半，你們途徑一座小島，暫時停留休息。\n在島上，花鈴聽到了異樣的聲音——\n一夥圖謀不軌的旅人現身了。",
          "zh_CN": "行程过半，你们途经一座小岛，暂时休整。\n在岛上，花铃听到了异样的声音——\n一伙图谋不轨的旅人现身了。",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
