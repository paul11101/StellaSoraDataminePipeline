        "/Name": {
          "key": "ActivityAvgLevel.10007.2",
          "zh_TW": "陰影之下",
          "zh_CN": "阴影之下",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        },
        "/Desc": {
          "key": "ActivityAvgLevel.10007.3",
          "zh_TW": "巨大的六角鯨來襲，你和花鈴合力甩掉了牠。\n就在你以為危機解除時，希婭卻陷入了漩渦。\n就在絕望之際，那片幽綠的光芒悄然降臨。",
          "zh_CN": "巨大的六角鲸袭来，你和花铃合力甩掉了它。\n就在你以为危机消散时，希娅却陷入了漩涡。\n绝望之际，那片幽绿的光芒悄然降临。",
          "sources": {
            "zh_TW": "language/zh_TW/ActivityAvgLevel.json",
            "zh_CN": "language/zh_CN/ActivityAvgLevel.json"
          }
        }
      }
