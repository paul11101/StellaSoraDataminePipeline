      "_localized": {
        "/Name": {
          "key": "ScoreBossAbility.100003.1",
          "zh_TW": "淋漓酣戰",
          "zh_CN": "淋漓酣战",
          "sources": {
            "zh_TW": "language/zh_TW/ScoreBossAbility.json",
            "zh_CN": "language/zh_CN/ScoreBossAbility.json"
          }
        },
        "/Desc": {
          "key": "ScoreBossAbility.100003.2",
          "zh_TW": "首領每5秒獲得1層「酣戰」，使自身造成的傷害提升<color=#ec6d21>&Param1&</color>，最多疊加5層。\n主控角色觸發「印記」時，移除1層「酣戰」。成功移除「酣戰」時，全隊獲得20點能量，並使首領受到的絕招傷害提升<color=#ec6d21>&Param2&</color>，持續10秒，重複觸發會重置時間",
          "zh_CN": "首领每5秒获得1层「酣战」,使自身造成的伤害提升<color=#ec6d21>&Param1&</color>，最多叠加5层。\n主控角色触发「印记」时，移除1层「酣战」。成功移除「酣战」时，全队获得20点能量，并使首领受到绝招伤害提升<color=#ec6d21>&Param2&</color>，持续10秒，每次触发重置时间",
          "sources": {
            "zh_TW": "language/zh_TW/ScoreBossAbility.json",
            "zh_CN": "language/zh_CN/ScoreBossAbility.json"
          }
        }
      }
    },
