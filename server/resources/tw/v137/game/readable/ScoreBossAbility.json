      "_localized": {
        "/Name": {
          "key": "ScoreBossAbility.100002.1",
          "zh_TW": "災厄火環",
          "zh_CN": "灾厄火环",
          "sources": {
            "zh_TW": "language/zh_TW/ScoreBossAbility.json",
            "zh_CN": "language/zh_CN/ScoreBossAbility.json"
          }
        },
        "/Desc": {
          "key": "ScoreBossAbility.100002.2",
          "zh_TW": "首領敵人擁有「火環」時，使首領敵人造成的傷害提升<color=#ec6d21>&Param1&</color>，且持續對環內的玩家角色造成傷害。\n當己方在5秒內，對首領敵人累計觸發3次「元素印記」後，可獲得「強化」使全隊普攻傷害提升<color=#ec6d21>&Param2&</color>，持續10秒，同時讓首領敵人的「火環」失效10秒",
          "zh_CN": "首领敌人拥有「火环」使首领敌人造成伤害提升<color=#ec6d21>&Param1&</color>，且持续对环内的玩家角色造成伤害。\n当己方在5秒内，对首领敌人累计触发3次「元素印记」后，可获得「强化」使全队普攻伤害提升<color=#ec6d21>&Param2&</color>持续10秒，同时让首领敌人「火环」失效10秒",
          "sources": {
            "zh_TW": "language/zh_TW/ScoreBossAbility.json",
            "zh_CN": "language/zh_CN/ScoreBossAbility.json"
          }
        }
      }
    },
