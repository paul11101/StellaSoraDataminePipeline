            "zh_CN": "language/zh_CN/ScoreBossAbility.json"
          }
        },
        "/Desc": {
          "key": "ScoreBossAbility.100019.2",
          "zh_TW": "主控角色對首領造成普攻傷害後，首領受到的絕招傷害強度提高<color=#ec6d21>&Param1&</color>，持續<color=#ec6d21>&Param2&</color>秒，最多疊加<color=#ec6d21>&Param3&</color>層，每0.5秒最多觸發一次。\n全隊的防禦穿透屬性提高<color=#ec6d21>&Param4&</color>點，援護角色在場期間，全隊的防禦穿透屬性提高<color=#ec6d21>&Param5&</color>",
          "zh_CN": "主控角色对首领造成普攻伤害后，首领受到的绝招伤害强度提高<color=#ec6d21>&Param1&</color>，持续<color=#ec6d21>&Param2&</color>秒，最多叠加<color=#ec6d21>&Param3&</color>层，每0.5秒最多触发一次。\n全队的防御穿透属性提高<color=#ec6d21>&Param4&</color>点，援护角色在场期间，全队的防御穿透属性提高<color=#ec6d21>&Param5&</color>",
          "sources": {
            "zh_TW": "language/zh_TW/ScoreBossAbility.json",
            "zh_CN": "language/zh_CN/ScoreBossAbility.json"
          }
        }
      }
