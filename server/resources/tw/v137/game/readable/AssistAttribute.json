      "_localized": {
        "/Desc": {
          "key": "AssistAttribute.1.1",
          "zh_TW": "全員都擅長風元素的旅人組成的組隊\n使用風系隊伍貫徹飄逸而迅捷的戰鬥風格吧",
          "zh_CN": "全员都擅长风元素的旅人组成的配队\n使用风系队伍贯彻飘逸而迅捷的战斗风格吧",
          "sources": {
            "zh_TW": "language/zh_TW/AssistAttribute.json",
            "zh_CN": "language/zh_CN/AssistAttribute.json"
          }
        },
        "/CharDesc1": {
          "key": "AssistAttribute.1.2",
          "zh_TW": "先鋒旅人通常配置於主控位置\n造成大量傷害並可觸發對應屬性印記",
          "zh_CN": "先锋旅人通常配置于主控位置\n造成大量伤害并可触发对应属性印记",
          "sources": {
            "zh_TW": "language/zh_TW/AssistAttribute.json",
            "zh_CN": "language/zh_CN/AssistAttribute.json"
          }
        },
        "/CharDesc2": {
          "key": "AssistAttribute.1.3",
          "zh_TW": "均衡旅人可同時勝任主控或援護位置\n配置於援護位置時，能夠造成大量傷害並提供少量增益效果",
          "zh_CN": "均衡旅人可同时胜任主控或援护位置\n配置于援护位时，能够造成大量伤害并提供少量增益效果",
          "sources": {
            "zh_TW": "language/zh_TW/AssistAttribute.json",
            "zh_CN": "language/zh_CN/AssistAttribute.json"
          }
        },
        "/CharDesc3": {
          "key": "AssistAttribute.1.4",
          "zh_TW": "輔助旅人通常配置於援護位置\n附加對應屬性印記，並為隊伍提供增益效果",
          "zh_CN": "辅助旅人通常配置于援护位置\n附加对应属性印记，并为队伍提供增益效果",
          "sources": {
            "zh_TW": "language/zh_TW/AssistAttribute.json",
            "zh_CN": "language/zh_CN/AssistAttribute.json"
          }
        },
        "/TeamTitle": {
