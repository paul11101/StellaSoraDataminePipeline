      "_localized": {
        "/Name": {
          "key": "BreakOutLevel.301010111.1",
          "zh_TW": "星屑幻想",
          "zh_CN": "星屑幻想",
          "sources": {
            "zh_TW": "language/zh_TW/BreakOutLevel.json",
            "zh_CN": "language/zh_CN/BreakOutLevel.json"
          }
        },
        "/Desc": {
          "key": "BreakOutLevel.301010111.2",
          "zh_TW": "歡迎來到繚亂碎晶球，透過教學關了解基礎玩法吧：\n1.試著移動發射台，發射彈珠或反彈彈珠。\n2.發動角色技能，摧毀晶塊。\n3.了解如何得分，以及勝利與失敗機制。",
          "zh_CN": "欢迎来到缭乱碎晶球，通过教学关了解基础玩法吧：\n1.尝试移动发射台，发射弹珠或反弹弹珠。\n2.发动角色技能，摧毁晶块。\n3.了解如何得分，以及胜利失败机制。",
          "sources": {
            "zh_TW": "language/zh_TW/BreakOutLevel.json",
            "zh_CN": "language/zh_CN/BreakOutLevel.json"
          }
        }
      }
    },
