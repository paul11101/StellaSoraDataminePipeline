      "_localized": {
        "/Name": {
          "key": "StarTowerNPC.9174.1",
          "zh_TW": "維嘉爾",
          "zh_CN": "维嘉尔",
          "sources": {
            "zh_TW": "language/zh_TW/StarTowerNPC.json",
            "zh_CN": "language/zh_CN/StarTowerNPC.json"
          }
        },
        "/NPCDesc": {
          "key": "StarTowerNPC.9174.2",
          "zh_TW": "傳言中，神祕的兩位「星塔裡的惡魔」之一。\n她們似乎總是出現在休息整頓的旅人面前，並主動上前搭話。\n維嘉爾的手裡總是握著一面鏡子，旅人的理想都盡收她的眼底。\n在她的暗示與承諾中，總有旅人會接受她拋出的誘惑，而選擇放棄某些東西。",
          "zh_CN": "传言中，神秘的两位“星塔里的恶魔”之一。\n她们似乎总是出现在修整的旅人面前，并主动来搭话。\n维嘉尔的手里总是提着一面镜子，旅人的理想会在她眼中全盘揭示。\n在她的暗示与承诺中，总有旅人会接受她抛出的诱惑，而去放弃掉某些东西。",
          "sources": {
            "zh_TW": "language/zh_TW/StarTowerNPC.json",
            "zh_CN": "language/zh_CN/StarTowerNPC.json"
          }
        }
      }
    }
